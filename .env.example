# .env.example — commit this file
# .env       — never commit, add to .gitignore
#
# Copy this file to .env and fill in real values.
# All client-side vars MUST be prefixed EXPO_PUBLIC_
# Service role key NEVER goes here — Edge Functions only.

# ── Supabase ──────────────────────────────────────────
EXPO_PUBLIC_SUPABASE_URL=https://rocqjhbixkxzpyczvccl.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key_here

# ── Mapbox ────────────────────────────────────────────
# Token scopes: styles:read, fonts:read, tiles:read (read-only, no write)
# Create at: mapbox.com → Account → Access Tokens → rumbla-app-prod
EXPO_PUBLIC_MAPBOX_ACCESS_TOKEN=your_mapbox_access_token_here

# Custom dark style created in Mapbox Studio matching Design System palette
# Background: #0D0F14 · Roads: #1C2030 · Labels: #8B93A8 · Water: #0A0D12
EXPO_PUBLIC_MAPBOX_STYLE_URL=mapbox://styles/your_username/your_style_id

# ── App environment ───────────────────────────────────
EXPO_PUBLIC_APP_ENV=development
# Options: development | staging | production
